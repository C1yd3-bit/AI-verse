# Real accounts and published database content. No runtime sample catalog.
NEXT_PUBLIC_APP_MODE=account
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set both to configure authentication and published catalog reads.
# Preferences persist to verified accounts; restart after configuration changes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional legacy workers/artwork only; Storage uploads and playback use Edge runtime credentials.
SUPABASE_SERVICE_ROLE_KEY=
# Published database catalog only. This legacy setting cannot enable sample data.
AIVERSE_CATALOG_MODE=live
# Inactive legacy Stream adapter. Not required for current private Supabase Storage uploads.
AIVERSE_ENABLE_STREAM_UPLOADS=false
# Random 32+ character secret authorizing internal worker calls. Never send to browsers.
AIVERSE_WORKER_SECRET=
# Leave empty until the watch/provider-event retention policy is approved (30–365 days).
AIVERSE_RETENTION_DAYS=
# Inactive legacy provider settings; leave empty for the current Supabase Storage flow.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
